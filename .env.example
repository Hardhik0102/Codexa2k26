# Copy this file to ".env" and fill in your real PostgreSQL connection string.
#
# Easiest free option for a beginner: https://neon.tech (or https://supabase.com)
# Both give you a hosted PostgreSQL database with a ready-to-paste connection string.
# No local PostgreSQL install needed.

DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require

# Port the Express server will run on
PORT=5000
